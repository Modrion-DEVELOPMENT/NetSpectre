{
  "schema_version": 1,
  "packages": [
    {
      "id": "python",
      "name": "Python",
      "description": "Python runtime. Linux installer supports Debian/Ubuntu (apt); macOS requires Homebrew.",
      "version": "latest",
      "requirements": [],
      "install": {
        "windows": [
          "winget",
          "install",
          "--exact",
          "--id",
          "Python.Python.3.13"
        ],
        "macos": [
          "brew",
          "install",
          "python"
        ],
        "linux": [
          [
            "sudo",
            "apt-get",
            "update"
          ],
          [
            "sudo",
            "apt-get",
            "install",
            "-y",
            "python3",
            "python3-venv",
            "python3-pip"
          ]
        ]
      },
      "check": {
        "windows": [
          "py",
          "-3",
          "--version"
        ],
        "macos": [
          "python3",
          "--version"
        ],
        "linux": [
          "python3",
          "-c",
          "import venv, ensurepip"
        ]
      },
      "source": "local",
      "category": "runtime",
      "official_source": true,
      "standalone": true,
      "latest": false,
      "platform_requirements": {
        "macos": [
          "homebrew"
        ]
      }
    },
    {
      "id": "ollama",
      "name": "Ollama",
      "description": "Local model runtime. Start the Ollama app or ollama serve before pulling models.",
      "version": "latest",
      "requirements": [],
      "install": {
        "windows": [
          "winget",
          "install",
          "--exact",
          "--id",
          "Ollama.Ollama"
        ],
        "macos": [
          "brew",
          "install",
          "ollama"
        ],
        "linux": [
          [
            "curl",
            "--fail",
            "--show-error",
            "--location",
            "--proto",
            "=https",
            "--proto-redir",
            "=https",
            "--max-time",
            "120",
            "https://ollama.com/install.sh",
            "--output",
            "{ollama_installer}"
          ],
          [
            "sh",
            "{ollama_installer}"
          ]
        ]
      },
      "check": {
        "windows": [
          "ollama",
          "--version"
        ],
        "macos": [
          "ollama",
          "--version"
        ],
        "linux": [
          "ollama",
          "--version"
        ]
      },
      "source": "local",
      "category": "runtime",
      "official_source": true,
      "standalone": true,
      "latest": true,
      "platform_requirements": {
        "macos": [
          "homebrew"
        ]
      }
    },
